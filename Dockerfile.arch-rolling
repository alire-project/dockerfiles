# Dockerfile for Arch rolling release GNAT

FROM archlinux

# glib2-devel is required by gtkada
#
# make, fakeroot and sudo come in via base-devel, so they are not
# listed explicitly below.
#
# Refresh the keyring first (works around stale-keyring CI failures),
# then do a single full upgrade + install so the whole toolchain is
# resolved against one mirror state. Finally drop the package cache to
# keep the image small.
RUN pacman-key --init && \
    pacman -Sy --noconfirm archlinux-keyring && \
    pacman -Syu --noconfirm \
        base-devel \
        bash \
        curl \
        git \
        glib2-devel \
        gcc-ada \
        jq \
        make \
        mercurial \
        python \
        python-pip \
        rsync \
        subversion \
        sudo \
        unzip \
        wget \
        fakeroot && \
    pacman -Scc --noconfirm

# gprbuild is not in official Arch repositories: it must be built
# separately from the AUR.

# Add a 'build' user to be able to create the package
RUN useradd --no-create-home --shell=/bin/false build && \
    echo "build ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/build

# Force generation of .tar.zst packages
RUN echo "PKGEXT='.pkg.tar.zst'" >> /etc/makepkg.conf

# Build the package as 'build' user
USER build
RUN cd /tmp && \
    git clone https://aur.archlinux.org/gprbuild-bootstrap.git && \
    cd /tmp/gprbuild-bootstrap && \
    makepkg -s

# Install the package as 'root' user, then clean up
USER root
RUN pacman --noconfirm -U \
        /tmp/gprbuild-bootstrap/gprbuild-bootstrap-*.pkg.tar.zst && \
    rm -rf /tmp/gprbuild-bootstrap /var/cache/pacman/pkg/*

RUN cat /etc/os-release && \
    gnat --version && \
    gprbuild --version
