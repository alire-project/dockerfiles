# Dockerfile for CentOS
# Currently used as "unsupported" linux test version

FROM quay.io/centos/centos:stream10
# CentOS has moved to a rolling release mode
# Stream 10 supported until 2030

ENV PATH=/opt/gnat/bin:/opt/gprbuild/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# BASE TOOLS
# EPEL must be installed in its own transaction, or packages coming from it
# (mercurial) are not found in the next one.
# --allowerasing needed for curl to replace the preinstalled curl-minimal,
# which otherwise conflicts the moment one of our crates installs regular curl.
# python3-devel is needed for e3.
RUN dnf makecache && \
    dnf install -y epel-release && \
    dnf install -y --allowerasing \
        bzip2 \
        curl \
        diffutils \
        fontconfig \
        gcc \
        git \
        jq \
        libX11 \
        libX11-xcb \
        make \
        mercurial \
        python3 \
        python3-devel \
        redhat-rpm-config \
        subversion \
        sudo \
        unzip \
        wget && \
    dnf clean all

# GNAT FSF via alr
ARG ALR_VERSION=2.1.1
RUN wget https://github.com/alire-project/alire/releases/download/v${ALR_VERSION}/alr-${ALR_VERSION}-bin-x86_64-linux.zip \
        -O /tmp/alr.zip && \
    unzip /tmp/alr.zip -d /tmp && \
    chmod +x /tmp/bin/alr && \
    /tmp/bin/alr -C /opt get gnat_native && \
    /tmp/bin/alr -C /opt get gprbuild && \
    rm -rf /tmp/alr.zip /tmp/bin && \
    mv /opt/gnat* /opt/gnat && \
    mv /opt/gprbuild* /opt/gprbuild

RUN cat /etc/os-release && \
    gnat --version && \
    gprbuild --version
